---
 .../FileSystem/FileMover.SourceCapability.cs  | 27 +++++++++-
 .../FileMoverSymlinkedSourceBoundaryTests.cs  | 53 +++++++++++++++++++
 2 files changed, 78 insertions(+), 2 deletions(-)

diff --git a/listenarr.infrastructure/FileSystem/FileMover.SourceCapability.cs b/listenarr.infrastructure/FileSystem/FileMover.SourceCapability.cs
index 012cf7237..9d4bc48b0 100644
--- a/listenarr.infrastructure/FileSystem/FileMover.SourceCapability.cs
+++ b/listenarr.infrastructure/FileSystem/FileMover.SourceCapability.cs
@@ -170,7 +170,10 @@ public partial class FileMover : IFilePublicationSourceCapability
     /// <summary>
     /// Whether any of these links physically sits inside a configured root: the directory that
     /// holds the link, resolved, is the root or below it, by the root's configured spelling or by
-    /// its real path. A root whose containment cannot be decided counts as containing it.
+    /// its real path. A root whose containment cannot be decided counts as containing it, and so
+    /// does a root whose real path cannot be established: compared by spelling alone, a root
+    /// reached through a link that is unreadable, deleted or dangling at check time would let a
+    /// link inside its real directory resolve and carry the source out.
     /// </summary>
     private async Task<bool> AnyLinkSitsInsideConfiguredRootAsync(IReadOnlyList<string> links)
     {
@@ -204,7 +207,8 @@ public partial class FileMover : IFilePublicationSourceCapability
             }
 
             var semantics = persisted.Value.Semantics;
-            var realRoot = SymlinkedAncestors.Resolve(canonicalRoot);
+            if (TryResolveRealRoot(canonicalRoot) is not { } realRoot)
+                return true;
             if (locations.Any(location =>
                     FileSystemPathIdentity.IsSameOrInside(location.Path, canonicalRoot, semantics)
                     || FileSystemPathIdentity.IsSameOrInside(location.Path, realRoot, semantics)))
@@ -214,6 +218,25 @@ public partial class FileMover : IFilePublicationSourceCapability
         return false;
     }
 
+    /// <summary>
+    /// A configured root's real path, or null when it cannot be established: the root's own chain
+    /// cannot be inspected, is broken, or does not end at an existing directory.
+    /// </summary>
+    private static string? TryResolveRealRoot(string canonicalRoot)
+    {
+        try
+        {
+            var walk = SymlinkedAncestors.Walk(canonicalRoot);
+            return walk.BlockingLink == null && Directory.Exists(walk.ResolvedPath)
+                ? walk.ResolvedPath
+                : null;
+        }
+        catch (Exception exception) when (SymlinkedAncestors.IsInspectionFailure(exception))
+        {
+            return null;
+        }
+    }
+
     private async Task<PinnedDirectoryCreation.PinnedDirectoryAnchor> OpenSourceProofParentAsync(
         string parent, CancellationToken cancellationToken)
     {
diff --git a/tests/Features/Infrastructure/FileSystem/FileMoverSymlinkedSourceBoundaryTests.cs b/tests/Features/Infrastructure/FileSystem/FileMoverSymlinkedSourceBoundaryTests.cs
index 01069c204..2f87d7fcb 100644
--- a/tests/Features/Infrastructure/FileSystem/FileMoverSymlinkedSourceBoundaryTests.cs
+++ b/tests/Features/Infrastructure/FileSystem/FileMoverSymlinkedSourceBoundaryTests.cs
@@ -185,6 +185,59 @@ public sealed class FileMoverSymlinkedSourceBoundaryTests : BaseTests
         AssertRefusalNamesLink(outcome, Path.Join(real, "incoming"));
     }
 
+    // The root's real directory, and a link inside it, stay reachable while the link the root is
+    // configured through cannot be followed at check time. Its real path cannot be established,
+    // so the root has to count as containing the link rather than be compared by spelling alone.
+    [DirectoryLinkTheory]
+    [InlineData("unreadable")]
+    [InlineData("deleted")]
+    [InlineData("dangling")]
+    [Trait("Scenario", "A root whose real path cannot be established still contains the links in its real directory")]
+    public async Task ManagedRoot_ConfiguredThroughALinkThatCannotBeFollowed_LinkLeavingEveryRoot_IsRefused(string state)
+    {
+        var temp = FileService.GetTempDirectory("boundary-escape-unresolvable-root-" + state);
+        var outsideFile = Path.Join(Directory.CreateDirectory(Path.Join(temp, "outside", "Book")).FullName, "book.m4b");
+        await File.WriteAllTextAsync(outsideFile, "audio");
+        var library = Path.Join(temp, "library");
+        await AddAuthorizedRootAsync(library, "Library root");
+        var real = Directory.CreateDirectory(Path.Join(temp, "real-library")).FullName;
+        Directory.CreateSymbolicLink(Path.Join(real, "incoming"), Path.Join(temp, "outside"));
+        var guard = Directory.CreateDirectory(Path.Join(temp, "guard")).FullName;
+        var linkedRoot = Path.Join(guard, "linked-root");
+        Directory.CreateSymbolicLink(linkedRoot, real);
+        await AddAuthorizedRootAsync(linkedRoot, "Escape root");
+        switch (state)
+        {
+            case "deleted":
+                File.Delete(linkedRoot);
+                break;
+            case "dangling":
+                var moved = Path.Join(temp, "moved-library");
+                Directory.Move(real, moved);
+                real = moved;
+                break;
+        }
+
+        PublicationOutcome outcome;
+        if (state == "unreadable")
+            File.SetUnixFileMode(guard, UnixFileMode.None);
+        try
+        {
+            outcome = await PublishAsync(
+                FileAction.Move,
+                Path.Join(real, "incoming", "Book", "book.m4b"),
+                Path.Join(library, "Author", "Book", "book.m4b"));
+        }
+        finally
+        {
+            File.SetUnixFileMode(guard, UnixFileMode.UserRead | UnixFileMode.UserWrite | UnixFileMode.UserExecute);
+        }
+
+        Assert.True(File.Exists(outsideFile), "the file outside every root was retired through a link inside the root");
+        Assert.False(outcome.Supported, "a link inside a configured root carried the source outside every root");
+        AssertRefusalNamesLink(outcome, Path.Join(real, "incoming"));
+    }
+
     // Known gap, pinned as it stands rather than skipped. A chain outside every root resolves at
     // the capability gate, but preparing the publication then fails closed in its path-lock step:
     // nothing is published and the source is untouched. A skip would stop exercising either
